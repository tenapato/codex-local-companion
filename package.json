{
  "name": "codex-local-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Personal, loopback-only browser companion for the official Codex app-server",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
